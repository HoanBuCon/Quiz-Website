# ===================================
# FRONTEND PRODUCTION CONFIG (cPanel)
# ===================================
# Copy file này thành .env.production khi build cho production

# ⚠️ QUAN TRỌNG: Phải dùng HTTPS và trùng với domain thực tế
# API Base URL - URL của backend trên hosting
REACT_APP_API_BASE_URL=https://yourdomain.com/api

# Ví dụ khác:
# Nếu backend ở subdomain: REACT_APP_API_BASE_URL=https://api.liemdai.io.vn
# Nếu backend ở subfolder: REACT_APP_API_BASE_URL=https://liemdai.io.vn/api
