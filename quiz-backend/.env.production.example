DATABASE_URL="your_production_database_url"
JWT_SECRET="your_production_jwt_secret"
NODE_ENV=production

# ⚠️ QUAN TRỌNG: CORS_ORIGIN phải trùng với domain frontend (dùng HTTPS)
CORS_ORIGIN=https://yourdomain.com

# ⚠️ Cookie Domain - Set để cookie hoạt động trên subdomain
# Ví dụ: .liemdai.io.vn (có dấu chấm đầu) sẽ hoạt động cho cả www.liemdai.io.vn và liemdai.io.vn
# KHÔNG set nếu frontend và backend cùng domain chính xác
COOKIE_DOMAIN=

# Document Storage (production uses ../documents folder next to chatbox)
DOCUMENTS_DIR=../documents

# SMTP
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_SECURE=false # true if your SMTP server requires TLS
SMTP_USER=your-smtp@domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Quiz App <your-smtp@domain.com>"
SMTP_TLS_REJECT_UNAUTHORIZED=true
OTP_TTL_SECONDS=300
OTP_THROTTLE_SECONDS=60
OTP_MAX_ATTEMPTS=5

GEMINI_API_KEY=điền_api_key_của_bạn_vào_đây
# Hoặc: API_KEY=điền_api_key_của_bạn_vào_đây